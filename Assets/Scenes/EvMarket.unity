      m_Calls: []
  m_text: "<color=#D92626><size=32><b>[X] Merdivenlere ve asans\xF6re KO\u015EMA!</b></size></color>\n<size=19><color=#443834>Sars\u0131nt\u0131
    an\u0131nda merdivenler rezonansla an\u0131nda y\u0131k\u0131labilir, asans\xF6rler
    kilitlenir.</color></size>\n\n\n<color=#D92626><size=32><b>[X] Pencere ve balkonlardan
    UZAK DUR!</b></size></color>\n<size=19><color=#443834>Camlar patlayarak \xF6l\xFCmc\xFCl
    \u015Farapnel etkisi yarat\u0131r, balkonlar dayan\u0131ks\u0131zd\u0131r.</color></size>\n\n\n<color=#16943C><size=32><b>[+]
    Sa\u011Flam bir nesnenin yan\u0131na \xC7\xD6K - KAPAN - TUTUN!</b></size></color>\n<size=19><color=#443834>Masa
    veya sa\u011Flam baza yan\u0131nda cenin pozisyonu al, ba\u015F\u0131n\u0131
    ve enseni koru!</color></size>"
