  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 <b>\xC7\xD6K - KAPAN - TUTUN:</b> Sa\u011Flam bir masa veya bazan\u0131n
    yan\u0131na \xE7\xF6k\xFCn, ba\u015F ve enseyi koruyarak mobilyaya s\u0131k\u0131ca
    tutunun.\n\n\u2022 <b>ASLA KO\u015EMAYIN:</b> Merdivenlere, yang\u0131n merdivenlerine
    ve asans\xF6rlere kesinlikle ko\u015Fmay\u0131n! Binalarda ilk \xE7\xF6ken k\u0131s\u0131mlard\u0131r.\n\n\u2022
    <b>Camlardan Uzak Durun:</b> Pencerelerden ve balkonlardan derhal uzakla\u015F\u0131n."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0161d805a3764c089bef00bfe00793f5, type: 2}
