      m_Calls: []
  m_text: "\u2022 <b>Mobilyalar\u0131 Sabitleyin:</b> Dolap, kitapl\u0131k ve a\u011F\u0131r
    beyaz e\u015Fyalar\u0131 duvara L-demirleriyle sabitleyin.\n\n\u2022 <b>Afet
    \xC7antas\u0131 Haz\u0131rlay\u0131n:</b> Su, konserve, deprem d\xFCd\xFC\u011F\xFC,
    fener, pilli radyo ve ilk yard\u0131m setini haz\u0131r bulundurun.\n\n\u2022
    <b>Toplanma Alan\u0131:</b> e-Devlet AFAD sistemi \xFCzerinden mahallenizdeki
    toplanma alan\u0131n\u0131 \xF6nceden \xF6\u011Frenin."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0161d805a3764c089bef00bfe00793f5, type: 2}
